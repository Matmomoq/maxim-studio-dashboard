# Both database endpoints must match their trusted TLS certificates.
AMO_DB_HOST=db.example.com
AMO_DB_PORT=3306
AMO_DB_NAME=amo_test
AMO_DB_USER=
AMO_DB_PASSWORD=
AMO_DB_CONNECT_TIMEOUT=10
AMO_DB_SSL_MODE=VERIFY_IDENTITY
# Optional path to a private CA bundle; empty uses system trust store.
AMO_DB_SSL_CA=

YCLIENTS_DB_HOST=db.example.com
YCLIENTS_DB_PORT=3306
YCLIENTS_DB_NAME=yclients_test
YCLIENTS_DB_USER=
YCLIENTS_DB_PASSWORD=
YCLIENTS_DB_CONNECT_TIMEOUT=10
YCLIENTS_DB_SSL_MODE=VERIFY_IDENTITY
YCLIENTS_DB_SSL_CA=

DASHBOARD_AUTH_REQUIRED=true
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SECRET_KEY=
DASHBOARD_SESSION_HOURS=12
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_CACHE_SECONDS=300
# Optional: DASHBOARD_TAG_MAPPING=/absolute/path/to/tag_mapping.json
# Optional: DASHBOARD_LOGIN_LIMIT_DB=/private/writable/path/login.sqlite3

# Subdomain is used for CRM links; OAuth settings for loader/call recordings.
AMO_SUBDOMAIN=
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=
# Do not add/change the encryption key for existing tokens without migration.
AMO_TOKEN_ENCRYPTION_KEY=
AMO_API_TIMEOUT=30
AMO_API_REQUESTS_PER_SECOND=6
